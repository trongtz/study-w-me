{
  "rules": {
    ".read": false,
    ".write": false,
    "workspaces": {
      "main": {
        "presence": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['uid', 'displayName', 'audioEnabled', 'videoEnabled', 'x', 'y'])",
            "uid": {
              ".validate": "newData.isString() && newData.val() === auth.uid"
            },
            "displayName": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120"
            },
            "audioEnabled": {
              ".validate": "newData.isBoolean()"
            },
            "videoEnabled": {
              ".validate": "newData.isBoolean()"
            },
            "x": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
            },
            "y": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "calls": {
          "$callerUid": {
            "$calleeUid": {
              ".read": "auth != null && (auth.uid === $callerUid || auth.uid === $calleeUid)",
              "offer": {
                ".write": "auth != null && auth.uid === $callerUid"
              },
              "answer": {
                ".write": "auth != null && auth.uid === $calleeUid"
              },
              "callerCandidates": {
                ".write": "auth != null && auth.uid === $callerUid"
              },
              "calleeCandidates": {
                ".write": "auth != null && auth.uid === $calleeUid"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        }
      }
    }
  }
}
